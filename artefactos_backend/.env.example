# Servidor HTTP
PORT=3001
FRONTEND_URL=http://localhost:3000
TZ=America/El_Salvador

# PostgreSQL (ver docker-compose.yml)
DB_HOST=localhost
DB_PORT=5433
DB_USER=cisterna
DB_PASSWORD=cisterna
DB_NAME=cisterna
# Crea/actualiza las tablas automáticamente a partir de las entidades (solo desarrollo)
DB_SYNCHRONIZE=true

# MQTT (ver docker-compose.yml)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=cisterna
# Registrar automáticamente un dispositivo nuevo al recibir su primer mensaje
MQTT_AUTO_REGISTER=true

# Minutos sin mensajes para considerar el dispositivo desconectado
DEVICE_OFFLINE_MINUTES=5
